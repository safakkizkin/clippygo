    "Clipboard history stays on this Mac. Nothing is uploaded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الحافظة يبقى على هذا الـ Mac. لا يتم رفع أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zwischenablageverlauf bleibt auf diesem Mac. Nichts wird hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard history stays on this Mac. Nothing is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial del portapapeles permanece en este Mac. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique du presse-papiers reste sur ce Mac. Rien n’est envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היסטוריית לוח הגזירים נשארת במק הזה. שום דבר לא מועלה."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia degli appunti resta su questo Mac. Nulla viene caricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード履歴はこのMac内にのみ保存されます。アップロードはしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 기록은 이 Mac에만 저장됩니다. 아무것도 업로드되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klembordgeschiedenis blijft op deze Mac. Er wordt niets geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia schowka pozostaje na tym Macu. Nic nie jest przesyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico da área de transferência fica neste Mac. Nada é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История буфера обмена остаётся на этом Mac. Ничего не отправляется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Urklippshistoriken stannar på den här Macen. Ingenting laddas upp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano geçmişi bu Mac’te kalır. Hiçbir şey yüklenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板历史仅保存在此 Mac 上。不会上传任何内容。"
          }
        }
      }
    },

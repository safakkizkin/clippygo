    "Couldn’t update login item. Try again from an installed copy of the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t update login item. Try again from an installed copy of the app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş öğesi güncellenemedi. Yüklü uygulamadan tekrar dene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldeobjekt konnte nicht aktualisiert werden. Bitte mit einer installierten App-Kopie erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour l’élément de connexion. Réessayez depuis une copie installée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar el inicio de sesión. Prueba desde una copia instalada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiornare l’elemento di login. Riprova da una copia installata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon login-item niet bijwerken. Probeer opnieuw vanuit een geïnstalleerde kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar o item de login. Tente de uma cópia instalada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目を更新できませんでした。インストール済みのアプリから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목을 업데이트할 수 없습니다. 설치된 앱에서 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新登录项。请从已安装的应用再试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить элемент входа. Попробуйте из установленной копии приложения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaktualizować elementu logowania. Spróbuj z zainstalowanej kopii."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديث عنصر تسجيل الدخول. حاول من نسخة مثبتة من التطبيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לעדכן את פריט ההתחברות. נסה מעותק מותקן של האפליקציה."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte uppdatera inloggningsobjektet. Försök från en installerad kopia."
          }
        }
      }
    },
